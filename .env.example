# Groq API Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
# Active options: openai/gpt-oss-120b (recommended), openai/gpt-oss-20b, qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-120b

# Embedding Model (FastEmbed)
# Options: BAAI/bge-small-en-v1.5, BAAI/bge-base-en-v1.5, sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector Store (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./data/chroma
COLLECTION_NAME=backend_docs

# Ingestion & Chunking Settings
DOCS_SOURCE_DIR=./docs_source
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K=4

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False
